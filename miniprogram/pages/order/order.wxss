.page {
  padding: 24rpx 24rpx calc(270rpx + env(safe-area-inset-bottom));
}

.auth-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(20, 42, 34, 0.72);
}

.auth-card {
  width: 100%;
  padding: 52rpx 40rpx 38rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  text-align: center;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(8, 35, 27, 0.24);
}

.auth-logo { width: 128rpx; height: 128rpx; border-radius: 24rpx; }
.auth-title { display: block; margin-top: 24rpx; color: #1f2b27; font-size: 38rpx; font-weight: 800; }
.auth-copy { display: block; margin: 18rpx 0 30rpx; color: #63716b; font-size: 26rpx; line-height: 1.6; }
.auth-card .auth-button { color: #fff; background: #0f8a6b; }
.auth-note { display: block; margin-top: 18rpx; color: #89938f; font-size: 22rpx; }

.delivery-scope-notice {
  display: grid;
  gap: 8rpx;
  padding: 22rpx;
  border: 2rpx solid #efad4d;
  border-radius: 14rpx;
  color: #704817;
  background: #fff6e7;
  font-size: 25rpx;
  line-height: 1.6;
}

.delivery-scope-title {
  color: #a85d00;
  font-size: 28rpx;
  font-weight: 800;
}

.delivery-confirm {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f3f7f5;
  color: #26352f;
  font-size: 25rpx;
  font-weight: 700;
}

.delivery-confirm label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shop-card,
.panel,
.product-card,
.cart {
  margin-bottom: 20rpx;
  border: 1rpx solid #dfe6df;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(35, 47, 42, 0.08);
}

.shop-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
}

.logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
}

.shop-copy {
  flex: 1;
  display: grid;
  gap: 6rpx;
}

.title,
.panel-title,
.product-name {
  color: #1f2b27;
  font-size: 34rpx;
  font-weight: 800;
}

.subtitle,
.panel-subtitle,
.product-desc,
.muted,
.empty {
  color: #63716b;
  font-size: 26rpx;
}

.orders-button,
.add-button,
.submit,
.panel button.active,
.tabs button.active {
  color: #fff;
  background: #0f8a6b;
}

.panel {
  padding: 22rpx;
}

.recharge-entry,
.recharge-submit {
  color: #fff;
  background: #0f8a6b;
}

.recharge-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  background: rgba(18, 39, 32, 0.55);
}

.recharge-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 24rpx 70rpx rgba(14, 37, 29, 0.22);
}

.recharge-head,
.recharge-custom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.recharge-title {
  display: block;
  color: #1f2b27;
  font-size: 36rpx;
  font-weight: 800;
}

.recharge-balance {
  display: block;
  margin-top: 6rpx;
  color: #63716b;
  font-size: 24rpx;
}

.recharge-dialog .recharge-close {
  flex: 0 0 52rpx;
  width: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  max-height: 52rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  color: #64716c;
  background: #f1f4f1;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.recharge-presets {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.recharge-dialog .recharge-presets button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #dce5e0;
  box-sizing: border-box;
  color: #26352f;
  background: #f8faf8;
  font-size: 27rpx;
  line-height: 70rpx;
}

.recharge-presets button.selected {
  border-color: #0f8a6b;
  color: #08775d;
  background: #eaf7f2;
}

.recharge-custom {
  margin-top: 22rpx;
  color: #52615b;
  font-size: 25rpx;
  font-weight: 700;
}

.recharge-input-wrap {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 8rpx;
  min-height: 74rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce5e0;
  border-radius: 12rpx;
  color: #08775d;
  background: #fff;
  font-size: 28rpx;
}

.recharge-input-wrap input {
  flex: 1;
  height: 70rpx;
  color: #1f2b27;
  font-size: 28rpx;
}

.recharge-tip {
  display: block;
  margin: 18rpx 0;
  color: #7a8781;
  font-size: 22rpx;
  line-height: 1.5;
}

.recharge-dialog .recharge-submit {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 82rpx;
  min-height: 82rpx;
  max-height: 82rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 80rpx;
  white-space: nowrap;
}

.panel-head,
.cart-head,
.cart-row,
.total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.segmented,
.tabs,
.pay-methods {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.segmented button,
.tabs button {
  min-width: 180rpx;
  border: 1rpx solid #dfe6df;
  color: #1f2b27;
  background: #fff;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.field-column {
  display: grid;
  gap: 16rpx;
  margin-top: 16rpx;
}

.field {
  min-height: 86rpx;
  border: 1rpx solid #dfe6df;
  border-radius: 12rpx;
  padding: 22rpx;
  color: #1f2b27;
  background: #fbfaf7;
}

.delivery-form {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 12rpx;
}

.delivery-field {
  display: grid;
  gap: 6rpx;
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #dfe6df;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fbfaf7;
}

.delivery-field-wide {
  grid-column: 1 / -1;
}

.delivery-field > text {
  color: #65736d;
  font-size: 21rpx;
  font-weight: 700;
}

.delivery-field input {
  width: 100%;
  height: 42rpx;
  min-height: 42rpx;
  color: #1f2b27;
  font-size: 27rpx;
  line-height: 42rpx;
}

.delivery-time-grid {
  grid-template-columns: 1fr 1fr;
}

.picker-field {
  min-height: 76rpx;
}

.picker-field strong {
  overflow: hidden;
  color: #1f2b27;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.success-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 39, 31, 0.68);
}

.success-card {
  width: 100%;
  padding: 40rpx 34rpx 30rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  text-align: center;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(8, 35, 27, 0.26);
}

.success-badge {
  display: inline-flex;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  color: #08775d;
  background: #e8f7f1;
  font-size: 22rpx;
  font-weight: 700;
}

.success-title,
.success-order-no,
.success-copy {
  display: block;
}

.success-title {
  margin-top: 22rpx;
  color: #172720;
  font-size: 44rpx;
  font-weight: 900;
}

.success-order-no {
  margin-top: 12rpx;
  color: #0f8a6b;
  font-size: 27rpx;
  font-weight: 800;
}

.success-copy {
  margin: 16rpx 0 28rpx;
  color: #63716b;
  font-size: 25rpx;
  line-height: 1.6;
}

.success-card .success-primary,
.success-card .success-secondary {
  width: 100%;
  height: 78rpx;
  margin: 12rpx 0 0;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.success-card .success-primary {
  color: #fff;
  background: #0f8a6b;
}

.success-card .success-secondary {
  border: 1rpx solid #d9e4df;
  color: #315148;
  background: #f7faf8;
}

.tabs {
  white-space: nowrap;
  width: 100%;
  margin-top: 4rpx;
  margin-bottom: 20rpx;
}

.tabs-track {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-width: 100%;
  padding: 4rpx 2rpx;
  box-sizing: border-box;
}

.tabs button {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  max-width: none;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.tabs button::after {
  border: 0;
}

.products {
  display: grid;
  gap: 18rpx;
}

.product-card {
  display: grid;
  grid-template-columns: 148rpx 1fr auto;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx;
}

.product-image,
.product-placeholder {
  width: 148rpx;
  height: 148rpx;
  border-radius: 16rpx;
}

.product-placeholder {
  display: grid;
  place-items: center;
  color: #fff;
  background: #17352b;
  font-size: 52rpx;
  font-weight: 900;
}

.product-main {
  display: grid;
  gap: 10rpx;
}

.product-card .add-button {
  width: 126rpx;
  min-width: 126rpx;
  max-width: 126rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  justify-self: end;
  font-size: 20rpx;
  line-height: 52rpx;
  transition: transform 160ms ease, background-color 160ms ease;
}

.product-card .add-button.added {
  background: #176c57;
  transform: scale(0.96);
}

.cart-mask {
  position: fixed;
  inset: 0;
  z-index: 18;
  background: rgba(20, 38, 32, 0.34);
}

.cart {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 19;
  margin: 0;
  border: 0;
  border-top: 1rpx solid #dfe6df;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 20rpx env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -12rpx 36rpx rgba(35, 47, 42, 0.12);
}

.cart-expanded {
  max-height: 72vh;
}

.cart-details {
  padding: 22rpx 4rpx 6rpx;
}

.delivery-location,
.delivery-fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.delivery-location {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: #315b4e;
  background: #edf7f3;
  font-size: 24rpx;
}

.delivery-test-warning {
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  color: #9a4b00;
  background: #fff1dc;
  font-size: 24rpx;
  font-weight: 700;
}

.delivery-location button {
  flex: none;
  margin: 0;
}

.delivery-fee-row {
  padding: 12rpx 0 4rpx;
  color: #46534e;
  font-size: 25rpx;
}

.fee-waived,
.delivery-fee-hint {
  color: #0f7d62;
}

.delivery-fee-hint {
  display: block;
  padding-bottom: 10rpx;
  font-size: 23rpx;
}

.cart-detail-head,
.checkout-bar,
.note-row,
.pay-methods {
  display: flex;
  align-items: center;
}

.cart-detail-head {
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.cart-title {
  color: #1f2b27;
  font-size: 30rpx;
  font-weight: 800;
}

.cart-caption {
  margin-left: 12rpx;
  color: #63716b;
  font-size: 24rpx;
}

.close-cart {
  margin: 0;
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 0;
  color: #0f7d62;
  background: #edf7f3;
  font-size: 24rpx;
  line-height: 58rpx;
}

.cart-list {
  max-height: 300rpx;
}

.cart-row {
  min-height: 78rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #edf1ed;
}

.cart-product {
  display: grid;
  gap: 4rpx;
}

.cart-product-name {
  color: #1f2b27;
  font-size: 27rpx;
  font-weight: 700;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stepper button {
  width: 58rpx;
  min-width: 58rpx;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d7e3dd;
  border-radius: 50%;
  color: #0f7d62;
  background: #fff;
  font-size: 30rpx;
  line-height: 56rpx;
}

.cart-empty {
  padding: 30rpx 0;
  border-top: 1rpx solid #edf1ed;
  color: #63716b;
  text-align: center;
  font-size: 25rpx;
}

.checkout-options {
  padding: 14rpx 0 8rpx;
  border-top: 1rpx solid #edf1ed;
}

.note-row {
  gap: 16rpx;
}

.option-label {
  flex: 0 0 auto;
  color: #52615b;
  font-size: 24rpx;
  font-weight: 700;
}

.note-input {
  flex: 1;
  height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dfe6df;
  border-radius: 12rpx;
  color: #1f2b27;
  background: #f8faf8;
  font-size: 25rpx;
}

.pay-methods {
  gap: 12rpx;
  margin-top: 14rpx;
}

.pay-option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 66rpx;
  border: 1rpx solid #dfe6df;
  border-radius: 12rpx;
  color: #405049;
  background: #fff;
  font-size: 25rpx;
}

.pay-option.selected {
  border-color: #0f8a6b;
  color: #0b6d55;
  background: #edf8f4;
}

.pay-option radio {
  transform: scale(0.78);
}

.checkout-bar {
  flex-wrap: wrap;
  gap: 14rpx;
  min-height: 112rpx;
  padding: 12rpx 0;
}

.cart-summary {
  display: flex;
  flex: 0 0 100%;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 82rpx;
  margin: 0;
  padding: 8rpx 10rpx;
  border: 1rpx solid #cfe2d9;
  border-radius: 14rpx;
  color: #1f2b27;
  background: #f3faf7;
  text-align: left;
}

.cart-summary::after,
.close-cart::after {
  border: 0;
}

.cart-badge {
  display: grid;
  flex: 0 0 62rpx;
  width: 62rpx;
  height: 62rpx;
  place-items: center;
  border-radius: 50%;
  color: #fff;
  background: #17352b;
  font-size: 25rpx;
  font-weight: 800;
}

.summary-copy {
  display: grid;
  min-width: 0;
  gap: 2rpx;
}

.summary-title {
  font-size: 25rpx;
  font-weight: 800;
}

.summary-hint {
  overflow: hidden;
  color: #6b7872;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-detail-entry {
  flex: 0 0 auto;
  min-width: 104rpx;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #0f8a6b;
  box-sizing: border-box;
  text-align: center;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}

.checkout-total {
  display: grid;
  flex: 0 0 auto;
  gap: 2rpx;
  margin-left: auto;
  text-align: right;
}

.total-label {
  color: #6b7872;
  font-size: 20rpx;
}

.checkout-total .price {
  font-size: 31rpx;
}

.submit {
  width: auto;
  min-width: 166rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 76rpx;
}

.submit.disabled {
  color: #8d9994;
  background: #edf1ef;
}
