.page {
  padding: 24rpx;
}

.orders {
  display: grid;
  gap: 18rpx;
}

.order-card {
  display: grid;
  gap: 14rpx;
  border: 1rpx solid #dfe6df;
  border-radius: 16rpx;
  padding: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(35, 47, 42, 0.08);
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  color: #08775d;
  font-weight: 900;
}

.muted,
.empty {
  color: #63716b;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.refund-button {
  margin: 4rpx 0 0;
  border: 1rpx solid #d77b76;
  border-radius: 12rpx;
  color: #b52f29;
  background: #fff8f7;
  font-size: 26rpx;
  line-height: 72rpx;
}

.refund-button::after {
  border: 0;
}

.refund-locked {
  color: #8a9690;
  font-size: 24rpx;
}
