<view class="page">
  <view wx:if="{{orders.length}}" class="orders">
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="row">
        <text class="order-no">{{item.orderNo}}</text>
        <text>{{item.statusText}}</text>
      </view>
      <text class="muted">{{item.itemsText}}</text>
      <view class="row">
        <text>¥{{item.totalText}}</text>
        <text>{{item.fulfillmentLabel}}</text>
      </view>
      <button wx:if="{{item.canRefund}}" class="refund-button" data-id="{{item.id}}" bindtap="requestRefund">取消订单并退款</button>
      <text wx:elif="{{item.status !== 'pending'}}" class="refund-locked">店家已接单，订单不可退款</text>
    </view>
  </view>
  <view wx:else class="empty">暂无订单</view>
</view>
